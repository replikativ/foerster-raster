{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        org.replikativ/foerster {:mvn/version "0.1.83"}
        org.replikativ/raster {:mvn/version "0.2.1241"}}
 :aliases
 {;; raster's compiler JVM options
  :jvm {:jvm-opts ["--enable-native-access=ALL-UNNAMED" "--add-modules=jdk.incubator.vector"
                   "-Xss8m" "-XX:ReservedCodeCacheSize=512m" "-Xmx2g"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}
                 io.github.borkdude/gh-release-artifact {:git/sha "b946558225a7839f6a0f644834e838e190dc2262"}
                 babashka/babashka.curl {:mvn/version "0.1.2"}
                 babashka/fs {:mvn/version "0.3.17"}
                 cheshire/cheshire {:mvn/version "5.11.0"}}
          :ns-default build}
;; experiments with decoder LMs (pretrained-rstr, built against raster
  ;; 0.2.545); not a library dependency, and they load no foerster-raster block
  :lm {:extra-paths ["experiments"]
       :extra-deps {org.replikativ/pretrained-rstr {:mvn/version "0.1.55"}}
       :override-deps {org.replikativ/raster {:mvn/version "0.2.545"}}}
  :repl {:extra-paths ["test"]
         :extra-deps {nrepl/nrepl {:mvn/version "1.1.2"}}}
  ;; Code formatting check (CI) and fix
  :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :main-opts ["-m" "cljfmt.main" "check" "src" "test"]}
  :ffix   {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :main-opts ["-m" "cljfmt.main" "fix" "src" "test"]}}}
